# VentureOS Agent Engine Environment Variables
# Copy this file to .env and fill in your values

# ==================== API Keys (Required) ====================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# COHERE_API_KEY=your-cohere-key-here
# GOOGLE_API_KEY=your-google-key-here

# ==================== Server Configuration ====================
DEBUG=false
HOST=0.0.0.0
PORT=8000
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==================== Database Configuration ====================
DATABASE_URL=sqlite:///./agent_engine.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_engine
REDIS_URL=redis://localhost:6379/0
# VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_API_KEY=your-vector-db-key

# ==================== Logging ====================
LOG_LEVEL=INFO
# LOG_FILE=./logs/agent_engine.log
LOG_TO_CONSOLE=true

# ==================== LLM Defaults ====================
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_LLM_TEMPERATURE=0.7
DEFAULT_LLM_MAX_TOKENS=2048

# ==================== Budget Limits ====================
DEFAULT_BUDGET_MAX_COST=10.0
DEFAULT_BUDGET_MAX_REQUESTS=100
DEFAULT_BUDGET_MAX_DURATION_SECONDS=300

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=100000

# ==================== Cache ====================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ==================== Embedding ====================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
