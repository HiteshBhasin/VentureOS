.env
env
venv

# Python build artifacts
__pycache__/
*.pyc
*.pyo

# Dynamically generated agent code (written at runtime by CodingAgent /
# AgentFactory.spawn_dynamic_agent — regenerated per task, not source code)
venture-os/agent-engine/spawned_agents/*
!venture-os/agent-engine/spawned_agents/.gitkeep

# Per-task project output written by Orchestrator._write_project_output
venture-os/agent-engine/generated_projects/*
!venture-os/agent-engine/generated_projects/.gitkeep
mcp.json
.mcp.json

# Cached OAuth tokens for the CockroachDB Cloud MCP client (tools/bedrock_mcp_tool.py,
# tools/cockroach_mcp_client.py) — secrets, not source.
venture-os/agent-engine/.mcp_oauth_cache/